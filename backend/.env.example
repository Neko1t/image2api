# Lunixai backend config template. Copy to .env and fill in real values.
# Real environment variables override .env.

APP_ENV=development
APP_TITLE=Lunixai
HTTP_ADDR=:6666

# PostgreSQL (database must already exist; tables auto-migrate on boot)
POSTGRES_DSN=host=127.0.0.1 user=postgres password=YOUR_PASSWORD dbname=vivid_ai port=5432 sslmode=disable TimeZone=Asia/Shanghai

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# Frontend dev origins allowed for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Media storage. Keep rustfs for local development and as the rollback driver.
STORAGE_DRIVER=rustfs
RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_BUCKET=vivid-ai
RUSTFS_ACCESS_KEY=YOUR_RUSTFS_ACCESS_KEY
RUSTFS_SECRET_KEY=YOUR_RUSTFS_SECRET_KEY

# Alibaba Cloud OSS. These values are required only when STORAGE_DRIVER=oss.
# Keep direct delivery off for the initial OSS proxy-mode smoke test.
OSS_REGION=cn-hongkong
OSS_ENDPOINT=https://media.example.com
OSS_BUCKET=YOUR_PRIVATE_BUCKET
OSS_ACCESS_KEY_ID=YOUR_RAM_ACCESS_KEY_ID
OSS_ACCESS_KEY_SECRET=YOUR_RAM_ACCESS_KEY_SECRET
OSS_SESSION_TOKEN=
OSS_USE_CNAME=true
OSS_DIRECT_DELIVERY=false
OSS_SIGNED_URL_TTL_SECONDS=3600

# Optional: override generated media root (defaults to ../../ai-gateway/data/generated)
# GENERATED_ROOT=
